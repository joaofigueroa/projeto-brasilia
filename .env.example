DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Somente desenvolvimento: use `pnpm setup:local` para criar um banco isolado.
# BRASILIA_LOCAL_DATABASE=.local/postgres
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Opcional: preferir conectar uma chave gratuita do Gemini pela interface administrativa.
# GOOGLE_GENERATIVE_AI_API_KEY=
# Alternativa somente se já houver acesso e orçamento no AI Gateway:
# AI_GATEWAY_API_KEY=
# AI_RESEARCH_MODEL=anthropic/claude-haiku-5.5

# Neon Object Storage — credenciais somente no servidor; bucket privado.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=brasilia-client-files
