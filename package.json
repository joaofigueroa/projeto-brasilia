{
  "name": "projeto-brasilia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check-types": "next typegen && tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "setup:local": "node --conditions=react-server --import tsx scripts/setup-local.ts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.3.14",
    "@neondatabase/serverless": "^1.0.1",
    "ai": "^7.0.179",
    "better-auth": "^1.4.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.563.0",
    "motion": "^12.23.24",
    "next": "^16.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
